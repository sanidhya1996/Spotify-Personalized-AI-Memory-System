# ── Secrets — never commit ────────────────────────────────────────────
# §6.4 step 5: "Use a secret manager for model credentials, database
# endpoints, signing keys, encryption material... Commit only a safe
# .env.example."
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json

# ── Virtual environment (187 MB, rebuildable) ─────────────────────────
.venv/
venv/
env/
ENV/

# ── Python build artefacts ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ── Test and tooling caches ───────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ── Node (frontend tooling, if added) ─────────────────────────────────
node_modules/
npm-debug.log*
.next/

# ── Editor / OS noise ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Local runtime output ──────────────────────────────────────────────
*.log
logs/
data/local/
.logs/

# The assignment brief as a PDF. abc.md holds the same text and is what the
# code and docs cite, so the PDF stays local only.
projcet requirements.pdf
