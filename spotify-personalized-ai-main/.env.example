# Copy this file to .env. The passwords below are the local-only ones
# docker-compose.yml starts with; change them for any shared environment.
# abc.md:246 - commit only a safe .env.example, never real secrets.

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MEMORY_JWT_SECRET=local-dev-only-secret-change-me-before-any-deploy

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=memory_local_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=spotify_personalized_ai
POSTGRES_SSL=false
DATABASE_URL=

# --- Redis ----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=3
REDIS_SSL=false
REDIS_PREFIX=spotifymem

# --- Optional overrides ---------------------------------------------------
# A ready-made connection string wins over the fields above.

# --- Model (extraction, endpoint 2) -----------------------------------
# Free tier: aistudio.google.com -> Get API key
GEMINI_API_KEY=replace-me

# --- Neo4j (abc.md:210 - temporal graph memory) -----------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password___________1212121212

# --- Redpanda (abc.md:207 - durable event capture) --------------------
# Port 19092 is Redpanda's EXTERNAL listener. Port 9092 is the internal
# one, advertised as `redpanda:9092` - a hostname only other containers
# can resolve, so a client on this machine times out fetching metadata.
KAFKA_BOOTSTRAP=localhost:19092

# Only for a hosted Kafka (Redpanda Cloud, Confluent Cloud). Leave empty for
# Redpanda in Docker. See memory/queue.py connection_settings.
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=SCRAM-SHA-256

# --- Test-user logins (local testing only) -----------------------------
# Set a password here to give user_001 ... user_005 a login in the web app.
# Leave it empty on a server: then the only accounts are people who sign up.
DEMO_PASSWORD=
